From 3afbbb7ad6d53e7dd56192f7b7e2f211158abe5f Mon Sep 17 00:00:00 2001
From: Han Gao <gaohan@iscas.ac.cn>
Date: Wed, 12 Nov 2025 22:57:57 +0800
Subject: [PATCH 89/90] debian patch: fix patch max

From: https://salsa.debian.org/xorg-team/lib/mesa/-/blob/mesa-24.0.8-1/debian/patches/path_max.diff?ref_type=tags

Signed-off-by: Han Gao <gaohan@iscas.ac.cn>
---
 src/gallium/auxiliary/pipe-loader/pipe_loader.c | 4 ++++
 src/util/tests/cache_test.cpp                   | 4 ++--
 src/util/tests/process_test.c                   | 4 ++++
 3 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/src/gallium/auxiliary/pipe-loader/pipe_loader.c b/src/gallium/auxiliary/pipe-loader/pipe_loader.c
index ec8a0e0b28d..f38f04cf9a1 100644
--- a/src/gallium/auxiliary/pipe-loader/pipe_loader.c
+++ b/src/gallium/auxiliary/pipe-loader/pipe_loader.c
@@ -42,6 +42,10 @@
 #define PATH_MAX _MAX_PATH
 #endif
 
+#if !defined(PATH_MAX) && defined(__GNU__)
+#define PATH_MAX (4096)
+#endif
+
 #define MODULE_PREFIX "pipe_"
 
 static int (*backends[])(struct pipe_loader_device **, int) = {
diff --git a/src/util/tests/cache_test.cpp b/src/util/tests/cache_test.cpp
index 23732e325fe..ddc60021422 100644
--- a/src/util/tests/cache_test.cpp
+++ b/src/util/tests/cache_test.cpp
@@ -82,8 +82,8 @@ check_directories_created(void *mem_ctx, const char *cache_dir)
 {
    bool sub_dirs_created = false;
 
-   char buf[PATH_MAX];
-   if (getcwd(buf, PATH_MAX)) {
+   char *buf = getcwd(NULL, 0);
+   if (buf) {
       char *full_path = ralloc_asprintf(mem_ctx, "%s%s", buf, ++cache_dir);
       struct stat sb;
       if (stat(full_path, &sb) != -1 && S_ISDIR(sb.st_mode))
diff --git a/src/util/tests/process_test.c b/src/util/tests/process_test.c
index dd4e7bf8c7a..0e937e2c134 100644
--- a/src/util/tests/process_test.c
+++ b/src/util/tests/process_test.c
@@ -36,6 +36,10 @@
 #define PATH_MAX MAX_PATH
 #endif
 
+#if !defined(PATH_MAX) && defined(__GNU__)
+#define PATH_MAX (4096)
+#endif
+
 static bool error = false;
 
 static void
-- 
2.47.3

