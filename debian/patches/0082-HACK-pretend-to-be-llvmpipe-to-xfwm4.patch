From ccdfa16051ffd36bd6039fa04b36d77b8638b736 Mon Sep 17 00:00:00 2001
From: Icenowy Zheng <uwu@icenowy.me>
Date: Tue, 18 Nov 2025 22:16:36 +0800
Subject: [PATCH 82/84] HACK: pretend to be llvmpipe to xfwm4

The usage of GLX of xfwm4 is quirky and not well supported by Zink + IMG
proprietary Vulkan driver.

Signed-off-by: Icenowy Zheng <uwu@icenowy.me>
Signed-off-by: Han Gao <gaohan@iscas.ac.cn>
---
 src/util/00-mesa-defaults.conf | 1 +
 1 file changed, 1 insertion(+)

diff --git a/src/util/00-mesa-defaults.conf b/src/util/00-mesa-defaults.conf
index d88dc56f193..458f91fa7ca 100644
--- a/src/util/00-mesa-defaults.conf
+++ b/src/util/00-mesa-defaults.conf
@@ -781,6 +781,7 @@ TODO: document the other workarounds.
         </application>
         <application name="xfwm4" executable="xfwm4">
             <option name="adaptive_sync" value="false" />
+            <option name="force_gl_renderer" value="llvmpipe"/>
         </application>
         <application name="Enlightenment" executable="enlightenment">
             <option name="adaptive_sync" value="false" />
-- 
2.47.3

