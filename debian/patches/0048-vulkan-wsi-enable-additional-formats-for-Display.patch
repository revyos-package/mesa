From 4819d8763127d541c505d6994427a922c8a220c3 Mon Sep 17 00:00:00 2001
From: brendan King <Brendan.King@imgtec.com>
Date: Tue, 3 Aug 2021 15:44:57 +0100
Subject: [PATCH 48/84] vulkan/wsi: enable additional formats for Display

Add VK_FORMAT_R5G6B5_UNORM_PACK16.

This is for compatibility with IMG WSI.

Signed-off-by: Randolph Sapp <rs@ti.com>
---
 src/vulkan/wsi/wsi_common_display.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/vulkan/wsi/wsi_common_display.c b/src/vulkan/wsi/wsi_common_display.c
index f1e29ee08f4..d2f1c69da85 100644
--- a/src/vulkan/wsi/wsi_common_display.c
+++ b/src/vulkan/wsi/wsi_common_display.c
@@ -1183,6 +1183,13 @@ static const struct wsi_display_surface_format
       },
       .drm_format = DRM_FORMAT_XRGB8888
    },
+   {
+      .surface_format = {
+         .format = VK_FORMAT_R5G6B5_UNORM_PACK16,
+         .colorSpace = VK_COLOR_SPACE_SRGB_NONLINEAR_KHR,
+      },
+      .drm_format = DRM_FORMAT_RGB565
+   },
 };
 
 static void
