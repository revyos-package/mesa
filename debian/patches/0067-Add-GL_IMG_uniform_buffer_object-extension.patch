+
+<function name="GetActiveUniformBlockNameIMG" static_dispatch="false" es2="2.0"
+          alias="GetActiveUniformBlockName">
+    <param name="program" type="GLuint" />
+    <param name="uniformBlockIndex" type="GLuint" />
+    <param name="bufSize" type="GLsizei" />
+    <param name="length" type="GLsizei *" />
+    <param name="uniformBlockName" type="GLchar *" />
+</function>
+
+<function name="UniformBlockBindingIMG" static_dispatch="false" es2="2.0"
+          alias="UniformBlockBinding">
+    <param name="program" type="GLuint" />
+    <param name="uniformBlockIndex" type="GLuint" />
+    <param name="uniformBlockBinding" type="GLuint" />
+</function>
+
+<function name="GetIntegeri_vIMG" static_dispatch="false" es2="2.0"
+          offset="assign">
+    <param name="target" type="GLenum"/>
+    <param name="index" type="GLuint"/>
+    <param name="data" type="GLint*" output="true"/>
+</function>
+
+<function name="BindBufferRangeIMG" static_dispatch="false" es2="2.0"
+          alias="BindBufferRange">
+    <param name="target" type="GLenum"/>
+    <param name="index" type="GLuint"/>
+    <param name="buffer" type="GLuint"/>
+    <param name="offset" type="GLintptr"/>
+    <param name="size" type="GLsizeiptr"/>
+</function>
+
+<function name="BindBufferBaseIMG" static_dispatch="false" es2="2.0"
+          alias="BindBufferBase">
+    <param name="target" type="GLenum"/>
+    <param name="index" type="GLuint"/>
+    <param name="buffer" type="GLuint"/>
+</function>
+
+</category>
+
+</OpenGLAPI>
